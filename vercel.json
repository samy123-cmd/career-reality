{
    "crons": [
        {
            "path": "/internal/cron/freshness/?fetch_limit=8&warm_cache=False",
            "schedule": "0 */6 * * *"
        },
        {
            "path": "/internal/cron/freshness/?commit_refresh=True&strict_freshness=True&warm_cache=True&fetch_limit=12",
            "schedule": "30 2 * * *"
        },
        {
            "path": "/internal/cron/weekly-digest/",
            "schedule": "0 9 * * 1"
        },
        {
            "path": "/internal/cron/refresh-career-index/",
            "schedule": "0 3 1 * *"
        }
    ],
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "careerreality.in"
                }
            ],
            "destination": "https://www.careerreality.in/$1",
            "permanent": true
        }
    ],
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        },
        {
            "src": "staticfiles/**",
            "use": "@vercel/static"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
            ]
        },
        {
            "source": "/static/sw.js",
            "headers": [
                { "key": "Service-Worker-Allowed", "value": "/" },
                { "key": "Cache-Control", "value": "no-cache" }
            ]
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/staticfiles/$1",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.py"
        }
    ]
}
