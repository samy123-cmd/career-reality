# .env.example — copy to .env and fill in your values.
# This file is safe to commit. Never put real secrets here.

# ---- Core (required in production) ----
# For local dev: copy to .env and use DEBUG=True (SECRET_KEY auto-generated if omitted).
DEBUG=True
SECRET_KEY=change-me-use-a-long-random-string
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---- Database (required in production; omit locally to use SQLite) ----
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Cache (recommended in production for shared page cache) ----
REDIS_URL=redis://default:password@host:6379

# ---- Hosting (Fly.io) ----
# FLY_APP_NAME is injected automatically on Fly.
# DEPLOY_ENV=production
# ENFORCE_CANONICAL_HOST=true
# DB_CONN_MAX_AGE=0
# WEB_CONCURRENCY=2
# PORT=8000

# ---- Cron auth (HTTP endpoints + optional external scheduler) ----
# CRON_SECRET=long-random-token

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email ----
RESEND_API_KEY=
FROM_EMAIL=Career Reality <hello@yourdomain.com>

# ---- AI ----
OPENAI_API_KEY=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Advanced (optional) ----
# CANONICAL_BASE_URL=https://www.yourdomain.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CACHE_TIMEOUT_SECONDS=300
# WHITENOISE_MAX_AGE=31536000
